<!DOCTYPE html>
<html>

<head>
    <title>Label Inventaris - Thermal Printer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Courier New', monospace;
            /* Font yang lebih konsisten untuk thermal printer */
        }

        body {
            padding: 0;
            margin: 0;
            background: white;
        }

        /* Setting untuk ukuran label thermal printer */
        .label-container {
            width: 104mm;
            /* Lebar maksimal ZD220 */
            background: white;
            margin: 0;
            padding: 0;
        }

        .label {
            width: 100%;
            height: 25mm;
            /* Tinggi label individual */
            display: block;
            background: white;
            margin: 0;
            page-break-after: always;
            border: 1px solid #000;
            position: relative;
        }

        .label-content {
            height: 100%;
            width: 100%;
            display: flex;
            flex-direction: row;
            /* Barcode di kiri, info di kanan */
        }

        .barcode-section {
            width: 35%;
            padding: 2mm;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-right: 1px solid #000;
        }

        .barcode-section svg {
            max-width: 100%;
            height: 12mm;
        }

        .barcode-number {
            font-size: 6pt;
            font-weight: bold;
            margin-top: 1mm;
            text-align: center;
            word-break: break-all;
        }

        .info-section {
            width: 65%;
            padding: 1.5mm;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .info-row {
            margin: 0.5mm 0;
            font-size: 8pt;
            display: flex;
            align-items: center;
            line-height: 1.1;
        }

        .label-text {
            color: #000;
            display: inline-block;
            width: 12mm;
            font-weight: bold;
            font-size: 7pt;
        }

        .separator {
            display: inline-block;
            margin: 0 1mm;
            font-weight: bold;
        }

        .value-text {
            display: inline-block;
            font-weight: normal;
            font-size: 7pt;
            flex: 1;
            word-break: break-word;
        }

        /* Styling khusus untuk berbagai jenis info */
        .nama-barang {
            font-weight: bold;
            font-size: 8pt;
        }

        .kode-barang {
            font-family: 'Courier New', monospace;
            font-size: 7pt;
        }

        /* Layout alternatif untuk label yang lebih besar */
        .label-large {
            height: 38mm;
            /* Untuk label yang lebih tinggi */
        }

        .label-large .info-row {
            margin: 1mm 0;
            font-size: 9pt;
        }

        .label-large .label-text {
            font-size: 8pt;
        }

        .label-large .value-text {
            font-size: 8pt;
        }

        /* Print settings untuk thermal printer */
        @media print {
            @page {
                size: 104mm auto;
                /* Auto height untuk continuous paper */
                margin: 0;
            }

            html,
            body {
                width: 104mm;
                margin: 0;
                padding: 0;
            }

            .label {
                page-break-after: always;
                margin: 0;
            }

            /* Hindari page break di dalam label */
            .label-content {
                page-break-inside: avoid;
            }
        }

        /* Print settings untuk kertas A4 (testing) */
        @media print and (orientation: portrait) {
            @page {
                size: A4;
                margin: 5mm;
            }

            .label-container {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                justify-content: flex-start;
                align-items: flex-start;
            }

            .label {
                width: 104mm;
                height: 25mm;
                margin: 2mm;
                display: inline-block;
                page-break-after: auto;
            }

            /* Setiap 8 label, buat page break */
            .label:nth-child(8n) {
                page-break-after: always;
            }
        }
    </style>
</head>

<body>
    <div class="label-container">
        @foreach ($data as $item)
            <div class="label">
                <div class="label-content">
                    <div class="barcode-section">
                        {!! DNS1D::getBarcodeHTML($item->kode_barang, 'C39', 1.1, 35) !!}
                        <div class="barcode-number">{{ $item->kode_barang }}</div>
                    </div>
                    <div class="info-section">
                        <div class="info-row">
                            <span class="label-text">Nama</span>
                            <span class="separator">:</span>
                            <span class="value-text nama-barang">{{ Str::limit($item->barang->nama_barang, 25) }}</span>
                        </div>
                        <div class="info-row">
                            <span class="label-text">Kode</span>
                            <span class="separator">:</span>
                            <span class="value-text kode-barang">{{ $item->kode_barang }}</span>
                        </div>
                    </div>
                </div>
            </div>
        @endforeach
    </div>
</body>

</html>
